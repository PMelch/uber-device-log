{
  "name": "uber-device-log",
  "version": "0.10.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --import tsx scripts/dev.mjs",
    "build": "vue-tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "build:debug": "vue-tsc --noEmit && NODE_ENV=development vite build --mode development --outDir dist-debug",
    "start": "node bin/uber-device-log.mjs",
    "test": "node --import tsx --test server/*.test.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm test",
    "test:package": "node scripts/test-package.mjs",
    "blueprints:build": "node --import tsx scripts/build-blueprint-bundles.mjs",
    "blueprints:check": "node --import tsx scripts/build-blueprint-bundles.mjs --check",
    "skill:sync": "node scripts/sync-flow-skill.mjs",
    "skill:check": "node scripts/sync-flow-skill.mjs --check",
    "format:check": "node scripts/check-style.mjs check",
    "format": "node scripts/check-style.mjs write",
    "lint": "node scripts/check-style.mjs lint",
    "test:website:browser": "node scripts/build-site.mjs && node --import tsx scripts/test-website-flows.mjs",
    "test:flows:browser": "node --import tsx scripts/test-semantic-flows.mjs && node --import tsx scripts/test-flow-labels.mjs && node --import tsx scripts/test-flow-bundles.mjs",
    "tui": "bun tui/index.ts",
    "test:tui": "bun test tui/*.test.ts",
    "typecheck:tui": "tsc -p tsconfig.tui.json",
    "build:tui": "bun build --compile ./tui/index.ts ./tui/flow-worker.ts --outfile build/udl-tui"
  },
  "dependencies": {
    "@devicefarmer/adbkit": "^3.3.9",
    "@devicefarmer/adbkit-logcat": "2.1.3",
    "@tanstack/vue-virtual": "^3.13.52",
    "appium-ios-device": "^3.1.26",
    "express": "^5.3.0",
    "yaml": "^2.9.1",
    "yauzl": "3.4.0"
  },
  "overrides": {
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@opentui/core": "0.8.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "8.55.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.6.2",
    "eventsource": "5.1.4",
    "fuse.js": "^7.5.0",
    "playwright": "1.62.1",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.55.0",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "vue-eslint-parser": "10.2.0",
    "vue-tsc": "^3.3.14"
  },
  "description": "Local Android and iOS device log viewer with search, severity filters and export.",
  "license": "GPL-3.0-only",
  "bin": {
    "uber-device-log": "bin/uber-device-log.mjs",
    "udl": "bin/uber-device-log.mjs"
  },
  "files": [
    "bin/",
    "build/server/*.js",
    "build/shared/*.js",
    "dist/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PMelch/uber-device-log.git"
  },
  "bugs": {
    "url": "https://github.com/PMelch/uber-device-log/issues"
  },
  "homepage": "https://github.com/PMelch/uber-device-log#readme",
  "keywords": [
    "android",
    "ios",
    "logcat",
    "device",
    "logs"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
