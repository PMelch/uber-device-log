{
  "name": "uber-device-log",
  "version": "0.8.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "vue-tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "build:debug": "vue-tsc --noEmit && NODE_ENV=development vite build --mode development --outDir dist-debug",
    "start": "node bin/uber-device-log.mjs",
    "test": "node --import tsx --test server/*.test.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm test",
    "test:package": "node scripts/test-package.mjs"
  },
  "dependencies": {
    "@devicefarmer/adbkit": "^3.3.9",
    "@devicefarmer/adbkit-logcat": "2.1.3",
    "@tanstack/vue-virtual": "^3.13.44",
    "appium-ios-device": "^3.1.24",
    "express": "^5.2.1",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "fuse.js": "^7.5.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  },
  "description": "Local Android and iOS device log viewer with search, severity filters and export.",
  "license": "Apache-2.0",
  "bin": {
    "uber-device-log": "bin/uber-device-log.mjs",
    "udl": "bin/uber-device-log.mjs"
  },
  "files": [
    "bin/",
    "unity-package/",
    "docs/unity.md",
    "build/server/*.js",
    "build/shared/*.js",
    "dist/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PMelch/uber-device-log.git"
  },
  "bugs": {
    "url": "https://github.com/PMelch/uber-device-log/issues"
  },
  "homepage": "https://github.com/PMelch/uber-device-log#readme",
  "keywords": [
    "android",
    "ios",
    "logcat",
    "device",
    "logs"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
